package com.csc301.songmicroservice;import com.mongodb.client.result.DeleteResult;
import org.bson.types.ObjectId;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.ValueSource;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.data.mongodb.core.MongoTemplate;
import org.springframework.stereotype.Repository;
import java.util.HashMap;
import java.util.Map;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.eq;
import static org.mockito.Mockito.when;
import org.springframework.beans.factory.annotation.Autowired;

@Repository
class SongDalImplFindSongByIdTest {
    @Mock
    private MongoTemplate mongoTemplate;
    private SongDalImpl songDalImpl;
    @BeforeEach
    void setUp() {
        MockitoAnnotations.initMocks(this);
        songDalImpl = new SongDalImpl(mongoTemplate);
    }
    @Test
    @Tag("valid")
    void testFindExistingSongById() {
        // Arrange
        Song song = new Song("SongName", "ArtistName", "AlbumName");
        ObjectId songId = new ObjectId();
        song.setId(songId);
        when(mongoTemplate.findById(eq(songId), eq(Song.class))).thenReturn(song);
        // Act
        DbQueryStatus result = songDalImpl.findSongById(songId.toString());
        // Assert
        assertEquals(DbQueryStatus.DbQueryExecResult.QUERY_OK, result.getdbQueryExecResult());
        assertNotNull(result.getData());
        Map<String, String> expectedData = song.getJsonRepresentation();
        assertEquals(expectedData, result.getData());
    }
    @Test
    @Tag("invalid")
    void testFindNonExistentSongById() {
        // Arrange
        String nonExistentSongId = new ObjectId().toString();
        when(mongoTemplate.findById(any(ObjectId.class), eq(Song.class))).thenReturn(null);
        // Act
        DbQueryStatus result = songDalImpl.findSongById(nonExistentSongId);
        // Assert
        assertEquals(DbQueryStatus.DbQueryExecResult.QUERY_ERROR_NOT_FOUND, result.getdbQueryExecResult());
        assertNull(result.getData());
    }
    @ParameterizedTest
    @ValueSource(strings = {"invalidId", ""})
    @Tag("invalid")
    void testFindSongWithInvalidIdFormat(String invalidId) {
        // Act
        DbQueryStatus result = songDalImpl.findSongById(invalidId);
        // Assert
        assertEquals(DbQueryStatus.DbQueryExecResult.QUERY_ERROR_GENERIC, result.getdbQueryExecResult());
        assertNull(result.getData());
    }
    @ParameterizedTest
    @ValueSource(strings = {null, ""})
    @Tag("invalid")
    @Tag("boundary")
    void testFindSongWithNullOrEmptyId(String invalidId) {
        // Act
        DbQueryStatus result = songDalImpl.findSongById(invalidId);
        // Assert
        assertEquals(DbQueryStatus.DbQueryExecResult.QUERY_ERROR_GENERIC, result.getdbQueryExecResult());
        assertNull(result.getData());
    }
}