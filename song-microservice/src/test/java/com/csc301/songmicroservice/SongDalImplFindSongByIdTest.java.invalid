package com.csc301.songmicroservice;import com.mongodb.client.result.DeleteResult;
import org.bson.types.ObjectId;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.mongodb.core.MongoTemplate;
import org.springframework.stereotype.Repository;

@RunWith(MockitoJUnitRunner.class)
public class SongDalImplFindSongByIdTest {
    @Mock
    private MongoTemplate mongoTemplate;
    @InjectMocks
    private SongDalImpl songDalImpl;
    private Song testSong;
    @Before
    public void setUp() {
        testSong = new Song("Test Song", "Test Artist", "Test Album");
        Map<String, String> jsonRepresentation = new HashMap<>();
        jsonRepresentation.put(Song.KEY_SONG_NAME, testSong.getSongName());
        jsonRepresentation.put(Song.KEY_SONG_ARTIST_FULL_NAME, testSong.getSongArtistFullName());
        jsonRepresentation.put(Song.KEY_SONG_ALBUM, testSong.getSongAlbum());
        when(mongoTemplate.insert(any(Song.class), "songs")).thenReturn(testSong);
        when(mongoTemplate.findById(any(ObjectId.class), Song.class)).thenReturn(testSong);
        when(testSong.getJsonRepresentation()).thenReturn(jsonRepresentation);
    }
    @After
    public void tearDown() {
        testSong = null;
    }
    @Test
    @Category(Categories.valid.class)
    public void testFindExistingSongById() {
        ObjectId id = mongoTemplate.insert(testSong, "songs").getId();
        DbQueryStatus status = songDalImpl.findSongById(id.toHexString());
        assertEquals(DbQueryExecResult.QUERY_OK, status.getdbQueryExecResult());
        assertEquals(testSong.getJsonRepresentation(), status.getData());
    }
    @Test
    @Category(Categories.valid.class)
    public void testFindNonExistentSongById() {
        DbQueryStatus status = songDalImpl.findSongById("nonexistentid");
        assertEquals(DbQueryExecResult.QUERY_ERROR_NOT_FOUND, status.getdbQueryExecResult());
        assertNull(status.getData());
    }
    @Test
    @Category(Categories.invalid.class)
    public void testFindSongWithInvalidIdFormat() {
        DbQueryStatus status = songDalImpl.findSongById("invalidid");
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, status.getdbQueryExecResult());
        assertNull(status.getData());
    }
    @Test
    @Category(Categories.boundary.class)
    public void testFindSongWithNullOrEmptyId() {
        DbQueryStatus statusWithNull = songDalImpl.findSongById(null);
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, statusWithNull.getdbQueryExecResult());
        assertNull(statusWithNull.getData());
        DbQueryStatus statusWithEmpty = songDalImpl.findSongById("");
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, statusWithEmpty.getdbQueryExecResult());
        assertNull(statusWithEmpty.getData());
    }
}