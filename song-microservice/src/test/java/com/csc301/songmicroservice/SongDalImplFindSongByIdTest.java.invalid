package com.csc301.songmicroservice;
import java.util.HashMap;
import java.util.Map;
import org.bson.types.ObjectId;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.ArgumentMatchers;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.data.mongodb.core.MongoTemplate;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import com.mongodb.client.result.DeleteResult;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Repository;

@ExtendWith(MockitoExtension.class)
public class SongDalImplFindSongByIdTest {
    @Mock
    private MongoTemplate mongoTemplate;
    @Mock
    private Song songMock;
    private SongDalImpl songDal;
    @BeforeEach
    public void setup() {
        songDal = new SongDalImpl(mongoTemplate);
    }
    @Test
    @Tag("valid")
    public void returnsOkAndDataWhenSongExists() {
        String validId = new ObjectId().toHexString();
        Map<String, String> songJson = new HashMap<>();
        songJson.put(Song.KEY_SONG_NAME, "Test Song");
        songJson.put(Song.KEY_SONG_ARTIST_FULL_NAME, "Test Artist");
        songJson.put(Song.KEY_SONG_ALBUM, "Test Album");
        Mockito.when(mongoTemplate.findById(ArgumentMatchers.any(ObjectId.class), ArgumentMatchers.eq(Song.class)))
                .thenReturn(songMock);
        Mockito.when(songMock.getJsonRepresentation()).thenReturn(songJson);
        DbQueryStatus result = songDal.findSongById(validId);
        assertEquals((String) "GET", (String) result.getMessage());
        assertEquals((DbQueryExecResult) DbQueryExecResult.QUERY_OK, (DbQueryExecResult) result.getdbQueryExecResult());
        assertEquals((Object) songJson, (Object) result.getData());
        Mockito.verify(mongoTemplate, Mockito.times(1))
                .findById(ArgumentMatchers.any(ObjectId.class), ArgumentMatchers.eq(Song.class));
        Mockito.verify(songMock, Mockito.times(1)).getJsonRepresentation();
    }
    @Test
    @Tag("invalid")
    public void returnsErrorWhenObjectIdIsInvalid() {
        String invalidId = "invalid_object_id"; // TODO: Replace with scenario specific invalid id if needed
        DbQueryStatus result = songDal.findSongById(invalidId);
        assertEquals((String) "GET", (String) result.getMessage());
        assertNotEquals((DbQueryExecResult) DbQueryExecResult.QUERY_OK, (DbQueryExecResult) result.getdbQueryExecResult());
        assertNull((Object) result.getData());
        Mockito.verify(mongoTemplate, Mockito.never())
                .findById(ArgumentMatchers.any(ObjectId.class), ArgumentMatchers.eq(Song.class));
    }
    @Test
    @Tag("boundary")
    public void returnsErrorWhenSongNotFoundByValidId() {
        String validButMissingId = new ObjectId().toHexString();
        Mockito.when(mongoTemplate.findById(ArgumentMatchers.any(ObjectId.class), ArgumentMatchers.eq(Song.class)))
                .thenReturn(null);
        DbQueryStatus result = songDal.findSongById(validButMissingId);
        // Due to a null dereference in production code (calling getJsonRepresentation on null),
        // this falls into the catch block and returns an error status.
        assertEquals((String) "GET", (String) result.getMessage());
        assertNotEquals((DbQueryExecResult) DbQueryExecResult.QUERY_OK, (DbQueryExecResult) result.getdbQueryExecResult());
        assertNull((Object) result.getData());
        Mockito.verify(mongoTemplate, Mockito.times(1))
                .findById(ArgumentMatchers.any(ObjectId.class), ArgumentMatchers.eq(Song.class));
    }
    @Test
    @Tag("invalid")
    public void returnsErrorWhenMongoTemplateThrows() {
        String validId = new ObjectId().toHexString();
        Mockito.when(mongoTemplate.findById(ArgumentMatchers.any(ObjectId.class), ArgumentMatchers.eq(Song.class)))
                .thenThrow(new RuntimeException("Simulated DB error"));
        DbQueryStatus result = songDal.findSongById(validId);
        assertEquals((String) "GET", (String) result.getMessage());
        assertNotEquals((DbQueryExecResult) DbQueryExecResult.QUERY_OK, (DbQueryExecResult) result.getdbQueryExecResult());
        assertNull((Object) result.getData());
        Mockito.verify(mongoTemplate, Mockito.times(1))
                .findById(ArgumentMatchers.any(ObjectId.class), ArgumentMatchers.eq(Song.class));
    }
}