@Test
@Tag("valid")
void deleteSongByIdSuccessful() {
    String songId = "validSongId";
    DbQueryStatus successStatus = new DbQueryStatus("Song deleted successfully", DbQueryExecResult.QUERY_OK);
    Mockito.when(songDal.deleteSongById(songId)).thenReturn(successStatus);
    Mockito.when(request.getRequestURI()).thenReturn("/songs/" + songId);
    Response mockResponse = Mockito.mock(Response.class);
    Mockito.when(mockResponse.body()).thenReturn(Mockito.mock(okhttp3.ResponseBody.class));
    Mockito.when(mockResponse.body().string()).thenReturn("{\"status\":\"OK\"}");
    Mockito.when(client.newCall(Mockito.any()).execute()).thenReturn(mockResponse);
    Map<String, Object> response = songController.deleteSongById(songId, request);
    Mockito.verify(songDal, Mockito.times(1)).deleteSongById(songId);
    assert response.get("message").equals("Song deleted successfully");
    assert response.get("status").equals(200);
}
