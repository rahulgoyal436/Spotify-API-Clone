@ExtendWith(MockitoExtension.class)
public class SongControllerDeleteSongByIdTest {
    @Mock
    private SongDal songDal;
    @Mock
    private OkHttpClient client;
    @Mock
    private Call call;
    @InjectMocks
    private SongController controller;
    @Test
    @Tag("valid")
    public void deleteSongOkAndRemoteOkYieldsFinalOk() {
        final String songId = "song-123"; // TODO change if your IDs follow a different format
        final String expectedMessage = "Delete succeeded";
        final String expectedUrl = "http://localhost:3000/api/v1/songs/" + songId; // TODO change URL to match your environment
        DbQueryStatus dalStatus = new DbQueryStatus(expectedMessage, DbQueryExecResult.QUERY_OK);
        Mockito.when(songDal.deleteSongById(Mockito.eq(songId))).thenReturn(dalStatus);
        Response okHttpResponse = new Response.Builder()
                .request(new Request.Builder().url("http://localhost/dummy").build())
                .protocol(Protocol.HTTP_1_1)
                .code(200)
                .message("OK")
                .body(ResponseBody.create(MediaType.parse("application/json"), "{\"status\":\"OK\"}"))
                .build();
        Mockito.when(client.newCall(Mockito.any(Request.class))).thenReturn(call);
        try {
            Mockito.when(call.execute()).thenReturn(okHttpResponse);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        HttpServletRequest request = Mockito.mock(HttpServletRequest.class);
        try (MockedStatic<Utils> utilsMock = Mockito.mockStatic(Utils.class)) {
            utilsMock.when(() -> Utils.getUrl(Mockito.any(HttpServletRequest.class)))
                    .thenReturn(expectedUrl);
            utilsMock.when(() -> Utils.setResponseStatus(Mockito.anyMap(), Mockito.any(DbQueryExecResult.class), Mockito.any()))
                    .thenAnswer(invocation -> {
                        @SuppressWarnings("unchecked")
                        Map<String, Object> original = (Map<String, Object>) invocation.getArgument(0);
                        DbQueryExecResult execResult = (DbQueryExecResult) invocation.getArgument(1);
                        Object data = invocation.getArgument(2);
                        Map<String, Object> result = new HashMap<>(original);
                        result.put("status", execResult == DbQueryExecResult.QUERY_OK ? "OK" : "ERROR");
                        result.put("data", data);
                        return result;
                    });
            Map<String, Object> actual = controller.deleteSongById(songId, request);
            assertNotNull((Object) actual);
            assertEquals((Object) ("DELETE " + expectedUrl), (Object) actual.get("path"));
            assertEquals((Object) expectedMessage, (Object) actual.get("message"));
            assertEquals((Object) "OK", (Object) actual.get("status"));
        }
    }
