import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Repository;

@RunWith(MockitoJUnitRunner.class)
public class SongDalImplDeleteSongByIdTest {
    @Mock
    private MongoTemplate mongoTemplate;
    @InjectMocks
    private SongDalImpl songDalImpl;
    private Song validSong;
    private ObjectId validSongId;
    @Before
    public void setup() {
        validSong = new Song("Test Song", "Test Artist", "Test Album");
        validSongId = new ObjectId();
        validSong.setId(validSongId);
    }
    @Test
    @Category(Categories.valid.class)
    public void deleteSongByValidId() {
        when(mongoTemplate.findById(any(ObjectId.class), eq(Song.class))).thenReturn(validSong);
        when(mongoTemplate.remove(any(Song.class), eq("songs"))).thenReturn(DeleteResult.acknowledged(1));
        DbQueryStatus result = songDalImpl.deleteSongById(validSongId.toHexString());
        assertEquals(DbQueryExecResult.QUERY_OK, result.getDbQueryExecResult());
        verify(mongoTemplate, times(1)).findById(validSongId, Song.class);
        verify(mongoTemplate, times(1)).remove(validSong, "songs");
    }
    @Test
    @Category(Categories.invalid.class)
    public void deleteSongByInvalidId() {
        ObjectId invalidSongId = new ObjectId();
        when(mongoTemplate.findById(any(ObjectId.class), eq(Song.class))).thenReturn(null);
        DbQueryStatus result = songDalImpl.deleteSongById(invalidSongId.toHexString());
        assertEquals(DbQueryExecResult.QUERY_ERROR_NOT_FOUND, result.getDbQueryExecResult());
        verify(mongoTemplate, times(1)).findById(invalidSongId, Song.class);
        verify(mongoTemplate, never()).remove(any(Song.class), anyString());
    }
    @Test
    @Category(Categories.invalid.class)
    public void deleteSongByInvalidInput() {
        DbQueryStatus result = songDalImpl.deleteSongById(null);
        assertEquals(DbQueryExecResult.QUERY_ERROR_GENERIC, result.getDbQueryExecResult());
        verify(mongoTemplate, never()).findById(any(ObjectId.class), eq(Song.class));
        verify(mongoTemplate, never()).remove(any(Song.class), anyString());
    }
}