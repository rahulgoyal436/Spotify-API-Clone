    private SongDalImpl createDal() {
        return new SongDalImpl(mongoTemplate);
    }
    @Test
    @Tag("valid")
    public void testDeleteWithExistingSongAndAcknowledgedResultReturnsOk() {
        // Arrange
        String songId = "507f1f77bcf86cd799439011";
        Song foundSong = new Song("Title A", "Artist A", "Album A");
        foundSong.setId(new ObjectId(songId));
        when(mongoTemplate.findById(any(ObjectId.class), eq(Song.class))).thenReturn(foundSong);
        DeleteResult acknowledged = mock(DeleteResult.class);
        when(acknowledged.wasAcknowledged()).thenReturn(true);
        when(mongoTemplate.remove(same(foundSong), eq("songs"))).thenReturn(acknowledged);
        SongDalImpl dal = createDal();
        // Act
        DbQueryStatus result = dal.deleteSongById(songId);
        // Assert
        assertNotNull((DbQueryStatus) result);
        assertEquals((String) "DELETE", (String) result.getMessage());
        assertEquals((DbQueryExecResult) DbQueryExecResult.QUERY_OK, (DbQueryExecResult) result.getdbQueryExecResult());
        verify(mongoTemplate, times(1)).remove(same(foundSong), eq("songs"));
        // Additional assertion for add method as requested
        Song toAdd = new Song("Song X", "Artist X", "Album X");
        when(mongoTemplate.insert(same(toAdd), eq("songs"))).thenReturn(toAdd);
        DbQueryStatus addStatus = dal.addSong(toAdd);
        assertEquals((String) "POST", (String) addStatus.getMessage());
        assertEquals((DbQueryExecResult) DbQueryExecResult.QUERY_OK, (DbQueryExecResult) addStatus.getdbQueryExecResult());
        assertNotNull((Object) addStatus.getData());
    }
