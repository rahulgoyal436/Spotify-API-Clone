    @DisplayName("Valid song is inserted successfully and returns OK with JSON data")
    public void testAddSong_withValidSong_returnsOkAndSetsJsonData() {
        // Arrange
        Song songToAdd = org.mockito.Mockito.mock(Song.class);
        when(songToAdd.getSongName()).thenReturn("Track A");
        when(songToAdd.getSongAlbum()).thenReturn("Album A");
        when(songToAdd.getSongArtistFullName()).thenReturn("Artist A");
        Song inserted = org.mockito.Mockito.mock(Song.class);
        Map<String, String> expectedJson = new HashMap<>();
        expectedJson.put("id", "123"); // TODO: Adjust expected JSON structure if implementation changes
        when(inserted.getJsonRepresentation()).thenReturn(expectedJson);
        when(mongoTemplate.insert(eq(songToAdd), eq("songs"))).thenReturn(inserted);
        // Act
        DbQueryStatus result = songDal.addSong(songToAdd);
        // Assert
        verify(mongoTemplate, times(1)).insert(eq(songToAdd), eq("songs"));
        assertEquals((String) "POST", (String) result.getMessage());
        assertEquals((DbQueryExecResult) DbQueryExecResult.QUERY_OK, (DbQueryExecResult) result.getdbQueryExecResult());
        @SuppressWarnings("unchecked")
        Map<String, String> actualData = (Map<String, String>) result.getData();
        assertEquals((Object) expectedJson, (Object) actualData);
    }
