    public void addSong_whenDalOkAndExternalOk_returnsOkResponse() throws Exception {
        // Arrange
        Map<String, String> params = new HashMap<>();
        params.put(Song.KEY_SONG_NAME, "Song A"); // TODO: change test value if needed
        params.put(Song.KEY_SONG_ARTIST_FULL_NAME, "Artist A"); // TODO: change test value if needed
        params.put(Song.KEY_SONG_ALBUM, "Album A"); // TODO: change test value if needed
        HttpServletRequest request = Mockito.mock(HttpServletRequest.class);
        Map<String, String> dalData = new HashMap<>();
        dalData.put("id", "123"); // TODO: change test value if needed
        dalData.put("name", "Song A"); // TODO: change test value if needed
        String dalMessage = "added"; // TODO: change test value if needed
        DbQueryStatus dalStatus = new DbQueryStatus(dalMessage, DbQueryExecResult.QUERY_OK);
        dalStatus.setData(dalData);
        Mockito.when(songDal.addSong(Mockito.any(Song.class))).thenReturn(dalStatus);
        Call call = Mockito.mock(Call.class);
        Response response = Mockito.mock(Response.class);
        ResponseBody responseBody = Mockito.mock(ResponseBody.class);
        Mockito.when(response.body()).thenReturn(responseBody);
        Mockito.when(responseBody.string()).thenReturn("{\"status\":\"OK\"}");
        Mockito.when(client.newCall(Mockito.any(Request.class))).thenReturn(call);
        Mockito.when(call.execute()).thenReturn(response);
        String fixedUrl = "http://unit.test/songs"; // TODO: change test value if needed
        Map<String, Object> expectedResponse = new HashMap<>();
        expectedResponse.put("path", "POST " + fixedUrl);
        expectedResponse.put("message", dalMessage);
        expectedResponse.put("data", dalData);
        try (MockedStatic<Utils> utils = Mockito.mockStatic(Utils.class);
             MockedConstruction<FormBody.Builder> formBodyBuilderMock = Mockito.mockConstruction(FormBody.Builder.class, (mock, context) -> {
                 FormBody fb = Mockito.mock(FormBody.class);
                 Mockito.when(mock.build()).thenReturn(fb);
             });
             MockedConstruction<Request.Builder> requestBuilderMock = Mockito.mockConstruction(Request.Builder.class, (mock, context) -> {
                 Mockito.when(mock.url(Mockito.anyString())).thenReturn(mock);
                 Mockito.when(mock.post(Mockito.any(RequestBody.class))).thenReturn(mock);
                 Request reqMock = Mockito.mock(Request.class);
                 Mockito.when(mock.build()).thenReturn(reqMock);
             })) {
            utils.when(() -> Utils.getUrl(Mockito.any(HttpServletRequest.class))).thenReturn(fixedUrl);
            utils.when(() -> Utils.setResponseStatus(Mockito.any(Map.class), Mockito.any(DbQueryExecResult.class), Mockito.any()))
                 .thenAnswer(invocation -> expectedResponse);
            // Act
            Map<String, Object> actual = songController.addSong(params, request);
            // Assert
            ArgumentCaptor<Song> songCaptor = ArgumentCaptor.forClass(Song.class);
            Mockito.verify(songDal, Mockito.times(1)).addSong(songCaptor.capture());
            Song captured = songCaptor.getValue();
            assertEquals("Song A", (String) captured.getSongName());
            assertEquals("Artist A", (String) captured.getSongArtistFullName());
            assertEquals("Album A", (String) captured.getSongAlbum());
            Mockito.verify(client, Mockito.times(1)).newCall(Mockito.any(Request.class));
            utils.verify(() -> Utils.setResponseStatus(Mockito.any(Map.class), Mockito.eq(DbQueryExecResult.QUERY_OK), Mockito.same(dalData)), Mockito.times(1));
            assertEquals("POST " + fixedUrl, (String) actual.get("path"));
            assertEquals(dalMessage, (String) actual.get("message"));
            assertSame(dalData, (Map<String, String>) actual.get("data"));
            assertEquals(expectedResponse, actual);
        }
    }
