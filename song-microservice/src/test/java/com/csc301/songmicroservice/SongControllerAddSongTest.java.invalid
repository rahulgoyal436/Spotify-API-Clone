    @BeforeEach
    public void setUp() throws Exception {
        mockSongDal = Mockito.mock(SongDal.class);
        mockHttpClient = Mockito.mock(OkHttpClient.class);
        songController = new SongController(mockSongDal);
        // Inject OkHttpClient into SongController via reflection
