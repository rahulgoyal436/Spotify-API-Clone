        utilsStaticMock.when(() -> Utils.getUrl(any(HttpServletRequest.class))).thenReturn("http://localhost/api/songs");
        utilsStaticMock.when(() -> Utils.setResponseStatus(anyMap(), any(DbQueryExecResult.class), any()))
